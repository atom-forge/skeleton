{
	"name": "skeleton",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun --bun x vite dev",
		"build": "bun --bun x vite build",
		"preview": "bun --bun x vite preview",
		"prepare": "bun --bun x svelte-kit sync || echo ''",
		"check": "bun --bun x svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun --bun x svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"start": "bun build/index.js",
		"cli": "bun run server/cli.ts",
		"contract:emit": "prisma contract emit",
		"prebuild": "prisma contract emit",
		"db:migrate": "prisma db migrate",
		"db:update": "prisma db update"
	},
	"devDependencies": {
		"@prisma/cli-engine": "0.9.0",
		"@sveltejs/adapter-node": "^6",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.4",
		"@types/node": "^26",
		"@types/nodemailer": "^8.0.2",
		"prisma": "8.0.0-rc.29",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#server/*": "./server/*.ts",
		"#shared/*": "./shared/*.ts"
	},
	"dependencies": {
		"@atom-forge/attachment": "^0.4.0",
		"@atom-forge/date-format": "^0.1.3",
		"@atom-forge/env-reader": "^0.2.0",
		"@atom-forge/expose": "^0.1.0",
		"@atom-forge/laminar": "^0.5.0",
		"@atom-forge/rpc": "^0.3.19",
		"@atom-forge/svelte-helpers": "^0.0.4",
		"@atom-forge/ui": "^0.1.0",
		"@lucide/svelte": "^1.59.0",
		"@prisma/orm-postgres": "8.0.0-rc.22",
		"dotenv": "^18.0.9",
		"lru-cache": "^11.5.3",
		"nodemailer": "^10.3.1",
		"sharp": "0.34.5",
		"zod": "^4.6.7"
	},
	"overrides": {
		"@prisma/orm-toolchain": "8.0.0-rc.22",
		"@prisma/orm-framework": "8.0.0-rc.22",
		"@prisma/orm-family-sql": "8.0.0-rc.22",
		"@prisma/orm-target-postgres": "8.0.0-rc.22"
	}
}
