# Public URL of the site (links in e-mails)
BASE_URL=http://localhost:5173
# adapter-node in production: must match BASE_URL's origin
# ORIGIN=https://example.com
# PORT=3000

# PostgreSQL (locally use an IPv4 address, not a .local name that also resolves to IPv6)
DATABASE_URL=postgresql://app:CHANGE_ME@127.0.0.1:5432/app

# Outgoing mail; empty logs the mails to the console
SMTP_URL=
EMAIL_FROM=App <robot@example.com>

# adapter-node behind a reverse proxy: the header that carries the visitor's protocol
# PROTOCOL_HEADER=x-forwarded-proto
